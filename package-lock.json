@import "tailwindcss";

/* Hide Arena Web Dev watermark badge */
iframe[src*="arena"],
iframe[src*="arenahq"],
[data-arena],
[data-arena-badge],
#__arena_badge__,
#arena-badge,
.arena-badge,
div[style*="position: fixed"][style*="right: 0px"][style*="bottom: 0px"],
body > div:last-child[class*="arena"],
iframe {
  display: none !important;
  visibility: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

/* Also hide any iframes injected at bottom-right (common Arena pattern) */
html > body > iframe[src*="arena"] {
  display: none !important;
}
